{
  "name": "@hyas/openkf",
  "description": "openkf theme",
  "version": "1.22.19",
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "defaults"
  ],
  "repository": "https://github.com/openkf/website",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "hugo new",
    "prestart": "npm run clean",
    "start": "hugo server --bind=0.0.0.0 --disableFastRender",
    "prebuild": "npm run clean",
    "build": "hugo --gc --minify --environment production",
    "build:preview": "npm run build -- -D -F",
    "clean": "node -e \"for (const path of ['public', 'resources']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "npm run -s lint:markdown",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "lint:markdown-fix": "markdownlint-cli2 --fix \"*.md\" \"content/**/*.md\"",
    "server": "hugo server",
    "test": "npm run -s lint",
    "test:build": "python scripts/check-docsy.py",
    "check": "hugo version",
    "clean:install": "node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "env": "env",
    "precheck": "npm version",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "auto-changelog": "^2.4",
    "autoprefixer": "^10.4",
    "markdownlint-cli2": "^0.13.0",
    "netlify-plugin-submit-sitemap": "^0.4.0",
    "postcss": "^8.4",
    "postcss-cli": "^11.0",
    "shx": "^0.3.4"
  },
  "otherDependencies": {
    "hugo": "0.121.2"
  }
}
